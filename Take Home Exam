    <!-- MAIN CONTAINER -->
    <main class="max-w-5xl mx-auto px-4 pt-8">

        <!-- STUDENT REGISTRATION CARD -->
        <section class="glass-card rounded-2xl p-6 mb-8 border-l-4 border-l-amber-500">
            <h2 class="text-lg font-bold text-slate-100 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-user-graduate text-amber-400"></i> Student Information
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1" for="student-name">Full Name *</label>
                    <input type="text" id="student-name" placeholder="Enter your full name" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-slate-100 text-sm focus:outline-none focus:border-amber-500 transition">
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1" for="student-class">Class / Group</label>
                    <input type="text" id="student-class" value="Year 5 Humanities" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-slate-100 text-sm focus:outline-none focus:border-amber-500 transition">
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Date</label>
                    <input type="text" id="test-date" readonly class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-slate-400 text-sm cursor-not-allowed">
                </div>
            </div>
        </section>

        <form id="test-form" onsubmit="event.preventDefault();">

            <!-- ================= SECTION A: PHYSICAL GEOGRAPHY ================= -->
            <div class="mb-10">
                <div class="flex items-center justify-between bg-gradient-to-r from-sky-900/80 to-slate-900 p-4 rounded-xl border border-sky-500/30 mb-6">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-sky-500/20 border border-sky-400/40 flex items-center justify-center text-sky-400 text-lg">
                            <i class="fa-solid fa-water"></i>
                        </div>
                        <div>
                            <h2 class="text-lg font-bold text-sky-200">SECTION A: Physical Geography – Under the Waves</h2>
                            <p class="text-xs text-sky-300/70">Ocean floor features, ocean layers &amp; marine navigation</p>
                        </div>
                    </div>
                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-sky-500/20 text-sky-300 border border-sky-500/40">15 Marks</span>
                </div>

                <!-- Q1: Ocean Coverage MCQ -->
                <div class="glass-card rounded-xl p-6 mb-6">
                    <div class="flex justify-between items-start mb-3">
                        <span class="text-xs font-bold text-sky-400 uppercase tracking-wider">Question 1 • 2 Marks</span>
                        <span class="text-xs text-slate-400">Multiple Choice</span>
                    </div>
                    <p class="text-slate-200 font-medium text-sm md:text-base mb-4">
                        What percentage of Earth's surface is covered by oceans, and what is the average depth of the ocean floor?
                    </p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <input type="radio" id="q1-a" name="q1" value="A" class="hidden custom-radio">
                            <label for="q1-a" class="flex items-center p-3 rounded-lg border border-slate-700 bg-slate-900/50 cursor-pointer text-sm text-slate-300 hover:border-sky-500/50 transition">
                                <span class="w-6 h-6 rounded-full border border-slate-600 flex items-center justify-center text-xs mr-3 font-semibold">A</span>
                                50% covered | Average depth 1,200 m
                            </label>
                        </div>
                        <div>
                            <input type="radio" id="q1-b" name="q1" value="B" class="hidden custom-radio">
                            <label for="q1-b" class="flex items-center p-3 rounded-lg border border-slate-700 bg-slate-900/50 cursor-pointer text-sm text-slate-300 hover:border-sky-500/50 transition">
                                <span class="w-6 h-6 rounded-full border border-slate-600 flex items-center justify-center text-xs mr-3 font-semibold">B</span>
                                71% covered | Average depth 3,700 m
                            </label>
                        </div>
                        <div>
                            <input type="radio" id="q1-c" name="q1" value="C" class="hidden custom-radio">
                            <label for="q1-c" class="flex items-center p-3 rounded-lg border border-slate-700 bg-slate-900/50 cursor-pointer text-sm text-slate-300 hover:border-sky-500/50 transition">
                                <span class="w-6 h-6 rounded-full border border-slate-600 flex items-center justify-center text-xs mr-3 font-semibold">C</span>
                                85% covered | Average depth 11,000 m
                            </label>
                        </div>
                        <div>
                            <input type="radio" id="q1-d" name="q1" value="D" class="hidden custom-radio">
                            <label for="q1-d" class="flex items-center p-3 rounded-lg border border-slate-700 bg-slate-900/50 cursor-pointer text-sm text-slate-300 hover:border-sky-500/50 transition">
                                <span class="w-6 h-6 rounded-full border border-slate-600 flex items-center justify-center text-xs mr-3 font-semibold">D</span>
                                30% covered | Average depth 500 m
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Q2: Ocean Layers MCQ -->
                <div class="glass-card rounded-xl p-6 mb-6">
                    <div class="flex justify-between items-start mb-3">
                        <span class="text-xs font-bold text-sky-400 uppercase tracking-wider">Question 2 • 3 Marks</span>
                        <span class="text-xs text-slate-400">Multiple Choice</span>
                    </div>
                    <p class="text-slate-200 font-medium text-sm md:text-base mb-4">
                        Which ocean zone is located below 1,000 metres depth, receives <strong>no sunlight</strong>, is freezing cold, and features creatures like the anglerfish and giant squid?
                    </p>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <div>
                            <input type="radio" id="q2-a" name="q2" value="A" class="hidden custom-radio">
                            <label for="q2-a" class="flex items-center p-3 rounded-lg border border-slate-700 bg-slate-900/50 cursor-pointer text-sm text-slate-300 hover:border-sky-500/50 transition">
                                <span class="w-6 h-6 rounded-full border border-slate-600 flex items-center justify-center text-xs mr-3 font-semibold">A</span>
                                Sunlight Zone (0 - 200m)
                            </label>
                        </div>
                        <div>
                            <input type="radio" id="q2-b" name="q2" value="B" class="hidden custom-radio">
                            <label for="q2-b" class="flex items-center p-3 rounded-lg border border-slate-700 bg-slate-900/50 cursor-pointer text-sm text-slate-300 hover:border-sky-500/50 transition">
                                <span class="w-6 h-6 rounded-full border border-slate-600 flex items-center justify-center text-xs mr-3 font-semibold">B</span>
                                Twilight Zone (200 - 1,000m)
                            </label>
                        </div>
                        <div>
                            <input type="radio" id="q2-c" name="q2" value="C" class="hidden custom-radio">
                            <label for="q2-c" class="flex items-center p-3 rounded-lg border border-slate-700 bg-slate-900/50 cursor-pointer text-sm text-slate-300 hover:border-sky-500/50 transition">
                                <span class="w-6 h-6 rounded-full border border-slate-600 flex items-center justify-center text-xs mr-3 font-semibold">C</span>
                                Midnight Zone (&gt; 1,000m)
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Q3: Interactive Floor Feature Matching -->
                <div class="glass-card rounded-xl p-6 mb-6">
                    <div class="flex justify-between items-start mb-3">
                        <span class="text-xs font-bold text-sky-400 uppercase tracking-wider">Question 3 • 4 Marks</span>
                        <span class="text-xs text-slate-400">Feature Matching</span>
                    </div>
                    <p class="text-slate-200 font-medium text-sm md:text-base mb-4">
                        Match each ocean floor feature to its correct geographical description:
                    </p>

                    <div class="space-y-4">
                        <!-- Match Item 1 -->
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center bg-slate-900/60 p-3 rounded-lg border border-slate-700/80">
                            <div class="md:col-span-4 font-semibold text-sky-300 text-sm">
                                <i class="fa-solid fa-water text-xs mr-1"></i> Continental Shelf
                            </div>
                            <div class="md:col-span-8">
                                <select id="match-1" class="w-full bg-slate-800 border border-slate-700 rounded-md px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-sky-500">
                                    <option value="">-- Select matching description --</option>
                                    <option value="reef">Rocky ridge built by tiny animals; a busy marine habitat</option>
                                    <option value="shelf">Shallow edge of land underwater, up to about 200m deep</option>
                                    <option value="trench">Deepest part of the ocean (e.g. Mariana Trench at 11,000m)</option>
                                    <option value="seabed">The bottom floor of the ocean made of sand, rock, and mud</option>
                                </select>
                            </div>
                        </div>

                        <!-- Match Item 2 -->
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center bg-slate-900/60 p-3 rounded-lg border border-slate-700/80">
                            <div class="md:col-span-4 font-semibold text-sky-300 text-sm">
                                <i class="fa-solid fa-fish text-xs mr-1"></i> Coral Reef
                            </div>
                            <div class="md:col-span-8">
                                <select id="match-2" class="w-full bg-slate-800 border border-slate-700 rounded-md px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-sky-500">
                                    <option value="">-- Select matching description --</option>
                                    <option value="reef">Rocky ridge built by tiny animals; a busy marine habitat</option>
                                    <option value="shelf">Shallow edge of land underwater, up to about 200m deep</option>
                                    <option value="trench">Deepest part of the ocean (e.g. Mariana Trench at 11,000m)</option>
                                    <option value="seabed">The bottom floor of the ocean made of sand, rock, and mud</option>
                                </select>
                            </div>
                        </div>

                        <!-- Match Item 3 -->
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center bg-slate-900/60 p-3 rounded-lg border border-slate-700/80">
                            <div class="md:col-span-4 font-semibold text-sky-300 text-sm">
                                <i class="fa-solid fa-mountain-sun text-xs mr-1"></i> Ocean Trench
                            </div>
                            <div class="md:col-span-8">
                                <select id="match-3" class="w-full bg-slate-800 border border-slate-700 rounded-md px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-sky-500">
                                    <option value="">-- Select matching description --</option>
                                    <option value="reef">Rocky ridge built by tiny animals; a busy marine habitat</option>
                                    <option value="shelf">Shallow edge of land underwater, up to about 200m deep</option>
                                    <option value="trench">Deepest part of the ocean (e.g. Mariana Trench at 11,000m)</option>
                                    <option value="seabed">The bottom floor of the ocean made of sand, rock, and mud</option>
                                </select>
                            </div>
                        </div>

                        <!-- Match Item 4 -->
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center bg-slate-900/60 p-3 rounded-lg border border-slate-700/80">
                            <div class="md:col-span-4 font-semibold text-sky-300 text-sm">
                                <i class="fa-solid fa-layer-group text-xs mr-1"></i> Seabed
                            </div>
                            <div class="md:col-span-8">
                                <select id="match-4" class="w-full bg-slate-800 border border-slate-700 rounded-md px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-sky-500">
                                    <option value="">-- Select matching description --</option>
                                    <option value="reef">Rocky ridge built by tiny animals; a busy marine habitat</option>
                                    <option value="shelf">Shallow edge of land underwater, up to about 200m deep</option>
                                    <option value="trench">Deepest part of the ocean (e.g. Mariana Trench at 11,000m)</option>
                                    <option value="seabed">The bottom floor of the ocean made of sand, rock, and mud</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Q4: Navigation Hazards Short Answer -->
                <div class="glass-card rounded-xl p-6 mb-6">
                    <div class="flex justify-between items-start mb-3">
                        <span class="text-xs font-bold text-sky-400 uppercase tracking-wider">Question 4 • 6 Marks</span>
                        <span class="text-xs text-slate-400">Short Explanation</span>
                    </div>
                    <p class="text-slate-200 font-medium text-sm md:text-base mb-2">
                        Why did Roman sailors call winter the <em>"Mare Clausum"</em> (Closed Sea), and what specific ocean floor or sea hazards made sailing dangerous?
                    </p>
                    <p class="text-xs text-slate-400 mb-4">
                        <i class="fa-solid fa-lightbulb text-amber-400 mr-1"></i>
                        <em>Tip: Mention winter storms, hidden reefs/rocks, or shallow water/sandbanks.</em>
                    </p>
                    <textarea id="q4-response" rows="4" placeholder="Write your explanation here..." class="w-full bg-slate-900 border border-slate-700 rounded-lg p-3 text-slate-200 text-sm focus:outline-none focus:border-sky-500 transition"></textarea>
                </div>
            </div>


            <!-- ================= SECTION B: ROMAN HISTORY & EMPIRE ================= -->
            <div class="mb-10">
                <div class="flex items-center justify-between bg-gradient-to-r from-rose-950/80 to-slate-900 p-4 rounded-xl border border-rose-500/30 mb-6">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-rose-500/20 border border-rose-400/40 flex items-center justify-center text-rose-400 text-lg">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <div>
                            <h2 class="text-lg font-bold text-rose-200">SECTION B: History &amp; Empire – Across the Empire</h2>
                            <p class="text-xs text-rose-300/70">The Roman Army, Mediterranean geography &amp; empire expansion</p>
                        </div>
                    </div>
                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-rose-500/20 text-rose-300 border border-rose-500/40">15 Marks</span>
                </div>

                <!-- Q5: Roman Soldier Equipment MCQ -->
                <div class="glass-card rounded-xl p-6 mb-6">
                    <div class="flex justify-between items-start mb-3">
                        <span class="text-xs font-bold text-rose-400 uppercase tracking-wider">Question 5 • 3 Marks</span>
                        <span class="text-xs text-slate-400">Multiple Choice</span>
                    </div>
                    <p class="text-slate-200 font-medium text-sm md:text-base mb-4">
                        What was the <strong>Scutum</strong> used by a Roman legionary, and how many soldiers made up a single Roman legion?
                    </p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <input type="radio" id="q5-a" name="q5" value="A" class="hidden roman-radio">
                            <label for="q5-a" class="flex items-center p-3 rounded-lg border border-slate-700 bg-slate-900/50 cursor-pointer text-sm text-slate-300 hover:border-rose-500/50 transition">
                                <span class="w-6 h-6 rounded-full border border-slate-600 flex items-center justify-center text-xs mr-3 font-semibold">A</span>
                                Curved wooden shield | ~5,000 soldiers per legion
                            </label>
                        </div>
                        <div>
                            <input type="radio" id="q5-b" name="q5" value="B" class="hidden roman-radio">
                            <label for="q5-b" class="flex items-center p-3 rounded-lg border border-slate-700 bg-slate-900/50 cursor-pointer text-sm text-slate-300 hover:border-rose-500/50 transition">
                                <span class="w-6 h-6 rounded-full border border-slate-600 flex items-center justify-center text-xs mr-3 font-semibold">B</span>
                                Iron throwing spear | ~80 soldiers per legion
                            </label>
                        </div>
                        <div>
                            <input type="radio" id="q5-c" name="q5" value="C" class="hidden roman-radio">
                            <label for="q5-c" class="flex items-center p-3 rounded-lg border border-slate-700 bg-slate-900/50 cursor-pointer text-sm text-slate-300 hover:border-rose-500/50 transition">
                                <span class="w-6 h-6 rounded-full border border-slate-600 flex items-center justify-center text-xs mr-3 font-semibold">C</span>
                                Short stabbing sword | ~300 soldiers per legion
                            </label>
                        </div>
                        <div>
                            <input type="radio" id="q5-d" name="q5" value="D" class="hidden roman-radio">
                            <label for="q5-d" class="flex items-center p-3 rounded-lg border border-slate-700 bg-slate-900/50 cursor-pointer text-sm text-slate-300 hover:border-rose-500/50 transition">
                                <span class="w-6 h-6 rounded-full border border-slate-600 flex items-center justify-center text-xs mr-3 font-semibold">D</span>
                                Iron strip armor | ~40,000 soldiers per legion
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Q6: Italian Geography MCQ -->
                <div class="glass-card rounded-xl p-6 mb-6">
                    <div class="flex justify-between items-start mb-3">
                        <span class="text-xs font-bold text-rose-400 uppercase tracking-wider">Question 6 • 3 Marks</span>
                        <span class="text-xs text-slate-400">Multiple Choice</span>
                    </div>
                    <p class="text-slate-200 font-medium text-sm md:text-base mb-4">
                        Italy is a boot-shaped <strong>peninsula</strong> surrounded by the Mediterranean Sea. What river was the city of Rome founded upon?
                    </p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <input type="radio" id="q6-a" name="q6" value="A" class="hidden roman-radio">
                            <label for="q6-a" class="flex items-center p-3 rounded-lg border border-slate-700 bg-slate-900/50 cursor-pointer text-sm text-slate-300 hover:border-rose-500/50 transition">
                                <span class="w-6 h-6 rounded-full border border-slate-600 flex items-center justify-center text-xs mr-3 font-semibold">A</span>
                                The River Nile
                            </label>
                        </div>
                        <div>
                            <input type="radio" id="q6-b" name="q6" value="B" class="hidden roman-radio">
                            <label for="q6-b" class="flex items-center p-3 rounded-lg border border-slate-700 bg-slate-900/50 cursor-pointer text-sm text-slate-300 hover:border-rose-500/50 transition">
                                <span class="w-6 h-6 rounded-full border border-slate-600 flex items-center justify-center text-xs mr-3 font-semibold">B</span>
                                The River Tiber
                            </label>
                        </div>
                        <div>
                            <input type="radio" id="q6-c" name="q6" value="C" class="hidden roman-radio">
                            <label for="q6-c" class="flex items-center p-3 rounded-lg border border-slate-700 bg-slate-900/50 cursor-pointer text-sm text-slate-300 hover:border-rose-500/50 transition">
                                <span class="w-6 h-6 rounded-full border border-slate-600 flex items-center justify-center text-xs mr-3 font-semibold">C</span>
                                The River Thames
                            </label>
                        </div>
                        <div>
                            <input type="radio" id="q6-d" name="q6" value="D" class="hidden roman-radio">
                            <label for="q6-d" class="flex items-center p-3 rounded-lg border border-slate-700 bg-slate-900/50 cursor-pointer text-sm text-slate-300 hover:border-rose-500/50 transition">
                                <span class="w-6 h-6 rounded-full border border-slate-600 flex items-center justify-center text-xs mr-3 font-semibold">D</span>
                                The River Rhine
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Q7: Roman Kit Matching -->
                <div class="glass-card rounded-xl p-6 mb-6">
                    <div class="flex justify-between items-start mb-3">
                        <span class="text-xs font-bold text-rose-400 uppercase tracking-wider">Question 7 • 3 Marks</span>
                        <span class="text-xs text-slate-400">Vocabulary Matching</span>
                    </div>
                    <p class="text-slate-200 font-medium text-sm md:text-base mb-4">
                        Match each Roman soldier term to its correct definition:
                    </p>

                    <div class="space-y-4">
                        <!-- Term 1 -->
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center bg-slate-900/60 p-3 rounded-lg border border-slate-700/80">
