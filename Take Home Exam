    <!-- RESULTS MODAL -->
    <div id="results-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 hidden flex items-center justify-center p-4 overflow-y-auto">
        <div class="glass-card bg-slate-900 border-slate-700 rounded-2xl max-w-2xl w-full p-6 md:p-8 shadow-2xl relative my-8 max-h-[90vh] overflow-y-auto">
            
            <div class="text-center mb-6">
                <div id="modal-badge" class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-amber-500/20 text-amber-400 text-3xl mb-3 border border-amber-500/40">
                    <i class="fa-solid fa-award"></i>
                </div>
                <h3 class="text-2xl font-black text-white" id="modal-title">Test Results</h3>
                <p class="text-sm text-slate-400 mt-1" id="modal-student-name">Student Name</p>
            </div>

            <!-- SCORE HIGHLIGHT BOX -->
            <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-5 mb-6 text-center">
                <div class="text-xs uppercase tracking-wider text-slate-400 font-bold mb-1">Final Mark Achieved</div>
                <div class="text-4xl md:text-5xl font-extrabold text-amber-400 my-1" id="modal-score">0 / 30</div>
                <div class="text-sm font-semibold text-slate-300" id="modal-percentage">(0%)</div>
                
                <div class="grid grid-cols-2 gap-4 mt-4 pt-4 border-t border-slate-700 text-left text-xs">
                    <div class="bg-sky-950/40 border border-sky-500/30 p-3 rounded-lg">
                        <span class="text-sky-400 font-bold block mb-0.5">Section A (Geography)</span>
                        <span class="text-slate-200 text-sm font-bold" id="score-sec-a">0 / 15</span>
                    </div>
                    <div class="bg-rose-950/40 border border-rose-500/30 p-3 rounded-lg">
                        <span class="text-rose-400 font-bold block mb-0.5">Section B (History)</span>
                        <span class="text-slate-200 text-sm font-bold" id="score-sec-b">0 / 15</span>
                    </div>
                </div>
            </div>

            <!-- DETAILED QUESTION FEEDBACK BREAKDOWN -->
            <div class="mb-6">
                <h4 class="text-sm font-bold text-slate-200 uppercase tracking-wider mb-3">Question Breakdown &amp; Feedback</h4>
                <div id="feedback-list" class="space-y-3 text-xs md:text-sm">
                    <!-- Dynamic Feedback Items Inserted Here -->
                </div>
            </div>

            <div class="flex flex-wrap gap-3 justify-end pt-4 border-t border-slate-800">
                <button type="button" onclick="closeModal()" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-lg text-sm transition">
                    Review Answers
                </button>
                <button type="button" onclick="resetTest()" class="px-5 py-2.5 bg-sky-600 hover:bg-sky-500 text-white font-semibold rounded-lg text-sm transition">
                    <i class="fa-solid fa-rotate-right mr-1"></i> Retake Test
                </button>
            </div>

        </div>
    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Set today's date on load
        document.addEventListener('DOMContentLoaded', () => {
            const today = new Date();
            document.getElementById('test-date').value = today.toLocaleDateString('en-GB', {
                day: 'numeric', month: 'short', year: 'numeric'
            });

            // Add event listeners to input elements for real-time progress update
            const inputs = document.querySelectorAll('input[type="radio"], select, textarea');
            inputs.forEach(input => {
                input.addEventListener('change', updateProgress);
                input.addEventListener('input', updateProgress);
            });
        });

        function updateProgress() {
            let answered = 0;
            const total = 8; // 8 question items

            if (document.querySelector('input[name="q1"]:checked')) answered++;
            if (document.querySelector('input[name="q2"]:checked')) answered++;
            
            // Match 1 check
            if (document.getElementById('match-1').value && 
                document.getElementById('match-2').value && 
                document.getElementById('match-3').value && 
                document.getElementById('match-4').value) answered++;

            if (document.getElementById('q4-response').value.trim().length > 10) answered++;

            if (document.querySelector('input[name="q5"]:checked')) answered++;
            if (document.querySelector('input[name="q6"]:checked')) answered++;

            // Vocabulary Match check
            if (document.getElementById('v-match-1').value && 
                document.getElementById('v-match-2').value && 
                document.getElementById('v-match-3').value) answered++;

            if (document.getElementById('q8-response').value.trim().length > 10) answered++;

            const percentage = Math.round((answered / total) * 100);
            document.getElementById('progress-bar').style.width = percentage + '%';
            document.getElementById('progress-text').innerText = `${answered}/${total} Completed`;
        }

        function submitTest() {
            const nameInput = document.getElementById('student-name').value.trim();
            if (!nameInput) {
                alert('Please enter your full name before submitting the test.');
                document.getElementById('student-name').focus();
                return;
            }

            let scoreA = 0;
            let scoreB = 0;
            let feedback = [];

            // --- SECTION A EVALUATION ---
            // Q1 (2 Marks)
            const q1Val = document.querySelector('input[name="q1"]:checked')?.value;
            if (q1Val === 'B') {
                scoreA += 2;
                feedback.push({ q: "Q1: Ocean Coverage & Depth", mark: "2/2", ok: true, text: "Correct! 71% coverage and ~3,700m average depth." });
            } else {
                feedback.push({ q: "Q1: Ocean Coverage & Depth", mark: "0/2", ok: false, text: "Incorrect. The ocean covers 71% of Earth with an average depth of 3,700m." });
            }

            // Q2 (3 Marks)
            const q2Val = document.querySelector('input[name="q2"]:checked')?.value;
            if (q2Val === 'C') {
                scoreA += 3;
                feedback.push({ q: "Q2: Ocean Depth Zones", mark: "3/3", ok: true, text: "Correct! Midnight Zone (>1,000m) is dark, freezing, and high pressure." });
            } else {
                feedback.push({ q: "Q2: Ocean Depth Zones", mark: "0/3", ok: false, text: "Incorrect. The Midnight Zone lies below 1,000m depth." });
            }

            // Q3 Matching (4 Marks)
            let matchScore = 0;
            if (document.getElementById('match-1').value === 'shelf') matchScore++;
            if (document.getElementById('match-2').value === 'reef') matchScore++;
            if (document.getElementById('match-3').value === 'trench') matchScore++;
            if (document.getElementById('match-4').value === 'seabed') matchScore++;
            scoreA += matchScore;
            feedback.push({ 
                q: "Q3: Ocean Floor Features", 
                mark: `${matchScore}/4`, 
                ok: matchScore === 4, 
                text: `You matched ${matchScore} out of 4 floor features correctly.` 
            });

            // Q4 Explanation Rubric (6 Marks)
            const q4Text = document.getElementById('q4-response').value.toLowerCase();
            let q4Score = 0;
            let q4Notes = [];

            if (q4Text.includes('winter') || q4Text.includes('storm') || q4Text.includes('closed') || q4Text.includes('weather')) {
                q4Score += 2;
                q4Notes.push('winter storms/weather');
            }
            if (q4Text.includes('reef') || q4Text.includes('rock') || q4Text.includes('hidden')) {
                q4Score += 2;
                q4Notes.push('hidden rocks/reefs');
            }
            if (q4Text.includes('shallow') || q4Text.includes('sandbank') || q4Text.includes('shelf') || q4Text.includes('aground') || q4Text.includes('depth')) {
                q4Score += 2;
                q4Notes.push('shallow water/depth hazards');
            }

            scoreA += q4Score;
            feedback.push({
                q: "Q4: Mare Clausum & Hazards",
                mark: `${q4Score}/6`,
                ok: q4Score >= 4,
                text: q4Score > 0 ? `Identified key factors: ${q4Notes.join(', ')}.` : "Ensure you explain winter storms and ocean floor hazards like reefs or shallows."
            });

            // --- SECTION B EVALUATION ---
            // Q5 (3 Marks)
            const q5Val = document.querySelector('input[name="q5"]:checked')?.value;
            if (q5Val === 'A') {
                scoreB += 3;
                feedback.push({ q: "Q5: Scutum & Legion Size", mark: "3/3", ok: true, text: "Correct! Scutum is a curved wooden shield and a legion contained ~5,000 men." });
            } else {
                feedback.push({ q: "Q5: Scutum & Legion Size", mark: "0/3", ok: false, text: "Incorrect. Scutum = curved shield; Legion = ~5,000 legionaries." });
            }

            // Q6 (3 Marks)
            const q6Val = document.querySelector('input[name="q6"]:checked')?.value;
            if (q6Val === 'B') {
                scoreB += 3;
                feedback.push({ q: "Q6: Geography of Rome", mark: "3/3", ok: true, text: "Correct! Rome was built on seven hills by the River Tiber in Italy." });
            } else {
                feedback.push({ q: "Q6: Geography of Rome", mark: "0/3", ok: false, text: "Incorrect. Rome was built on the River Tiber." });
            }

            // Q7 Matching (3 Marks)
            let vMatchScore = 0;
            if (document.getElementById('v-match-1').value === 'gladius') vMatchScore++;
            if (document.getElementById('v-match-2').value === 'pilum') vMatchScore++;
            if (document.getElementById('v-match-3').value === 'caligae') vMatchScore++;
            scoreB += vMatchScore;
            feedback.push({ 
                q: "Q7: Roman Soldier Kit Vocabulary", 
                mark: `${vMatchScore}/3`, 
                ok: vMatchScore === 3, 
                text: `You matched ${vMatchScore} out of 3 terms correctly.` 
            });

            // Q8 Explanation Rubric (6 Marks)
            const q8Text = document.getElementById('q8-response').value.toLowerCase();
            let q8Score = 0;
            let q8Notes = [];

            if (q8Text.includes('road') || q8Text.includes('march') || q8Text.includes('30') || q8Text.includes('fast')) {
                q8Score += 2;
                q8Notes.push('road marching efficiency');
            }
            if (q8Text.includes('sea') || q8Text.includes('ship') || q8Text.includes('grain') || q8Text.includes('nostrum') || q8Text.includes('trade')) {
                q8Score += 2;
                q8Notes.push('sea route supply/transport');
            }
            if (q8Text.includes('fort') || q8Text.includes('border') || q8Text.includes('camp') || q8Text.includes('control') || q8Text.includes('defend')) {
                q8Score += 2;
                q8Notes.push('fortified borders & control');
            }

            scoreB += q8Score;
            feedback.push({
                q: "Q8: Empire Expansion Geography",
                mark: `${q8Score}/6`,
                ok: q8Score >= 4,
                text: q8Score > 0 ? `Well explained! Mentioned: ${q8Notes.join(', ')}.` : "Explain how roads, sea supply routes, and strategic forts allowed army expansion."
            });

            // TOTALS
            const totalScore = scoreA + scoreB;
            const percentage = Math.round((totalScore / 30) * 100);

            // RENDER MODAL DATA
            document.getElementById('modal-student-name').innerText = `Student: ${nameInput} | Class: ${document.getElementById('student-class').value}`;
            document.getElementById('modal-score').innerText = `${totalScore} / 30`;
            document.getElementById('modal-percentage').innerText = `Overall Grade: ${percentage}%`;
            document.getElementById('score-sec-a').innerText = `${scoreA} / 15 Marks`;
            document.getElementById('score-sec-b').innerText = `${scoreB} / 15 Marks`;

            // Dynamic feedback elements
            const feedbackContainer = document.getElementById('feedback-list');
            feedbackContainer.innerHTML = '';

            feedback.forEach(item => {
                const div = document.createElement('div');
                div.className = `p-3 rounded-lg border ${item.ok ? 'bg-emerald-950/30 border-emerald-500/30 text-emerald-200' : 'bg-rose-950/30 border-rose-500/30 text-rose-200'}`;
                div.innerHTML = `
                    <div class="flex justify-between font-bold mb-1">
                        <span>${item.q}</span>
                        <span class="px-2 py-0.5 rounded text-xs ${item.ok ? 'bg-emerald-500/20 text-emerald-300' : 'bg-rose-500/20 text-rose-300'}">${item.mark}</span>
                    </div>
                    <p class="text-xs text-slate-300">${item.text}</p>
                `;
                feedbackContainer.appendChild(div);
            });

            // Show Modal
            document.getElementById('results-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('results-modal').classList.add('hidden');
        }

        function resetTest() {
            document.getElementById('test-form').reset();
            closeModal();
            updateProgress();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
</body>
