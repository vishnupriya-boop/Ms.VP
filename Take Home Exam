                            <div class="md:col-span-8">
                                <select id="v-match-2" class="w-full bg-slate-800 border border-slate-700 rounded-md px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-rose-500">
                                    <option value="">-- Select matching definition --</option>
                                    <option value="gladius">Short sword used for close stabbing combat</option>
                                    <option value="pilum">Throwing spear designed to bend when hitting shields</option>
                                    <option value="caligae">Hobnailed leather sandals built for long marching</option>
