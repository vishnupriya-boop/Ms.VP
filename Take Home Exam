            <!-- SUBMIT BUTTON -->
            <div class="text-center pt-4 pb-12">
                <button type="button" onclick="submitTest()" class="px-8 py-4 bg-gradient-to-r from-sky-500 via-indigo-500 to-rose-500 hover:from-sky-400 hover:to-rose-400 text-white font-extrabold rounded-xl text-lg shadow-xl shadow-indigo-500/25 transition transform hover:-translate-y-0.5 active:translate-y-0">
                    <i class="fa-solid fa-paper-plane mr-2"></i> Submit Test for Grading
