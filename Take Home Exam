                        <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center bg-slate-900/60 p-3 rounded-lg border border-slate-700/80">
                            <div class="md:col-span-4 font-semibold text-rose-300 text-sm">
                                Pilum
