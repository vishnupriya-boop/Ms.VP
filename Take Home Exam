</head>
<body class="min-h-screen pb-16">

    <!-- TOP STICKY HEADER -->
    <header class="sticky top-0 z-40 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 shadow-lg">
        <div class="max-w-5xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-4">
            <div>
                <div class="flex items-center gap-2">
                    <span class="px-2.5 py-0.5 rounded text-xs font-semibold bg-sky-500/20 text-sky-400 border border-sky-500/30">Stage 5 Humanities</span>
                    <span class="px-2.5 py-0.5 rounded text-xs font-semibold bg-rose-500/20 text-rose-400 border border-rose-500/30">Take-Home Test 2</span>
                </div>
                <h1 class="text-xl font-bold text-white mt-1">Under the Waves &amp; Across the Empire</h1>
            </div>
            
            <div class="flex items-center gap-6">
